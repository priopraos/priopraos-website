{
  "routes": [
    {
      "//": "Asset filenames carry a content hash, so a given URL's bytes never change. Cache them hard.",
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "//": "index.html names the hashed bundle. A stale copy points at a file the deploy has already replaced, that script 404s, and because this site ships as ONE bundle no JavaScript runs at all: a blank page. It was cached for 30 seconds; it must never be cached.",
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/*",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.svg",
      "/*.png",
      "/*.ico",
      "/*.json"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
